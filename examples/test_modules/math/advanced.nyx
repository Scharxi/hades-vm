// Advanced math functions
internal fun factorial_helper(n: Int, acc: Int): Int {
    if n <= 1 {
        return acc
    }
    return factorial_helper(n - 1, acc * n)
}

pub fun factorial(n: Int): Int {
    return factorial_helper(n, 1)
}

pub fun power(base: Int, exponent: Int): Int {
    if exponent == 0 {
        return 1
    }
    return base * power(base, exponent - 1)
} 