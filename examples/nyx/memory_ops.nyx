fun storeAndLoad(x: Int): Int {
    val addr = alloc(1)
    store(addr, x)
    return load(addr)
}

fun arraySum(size: Int): Int {
    val addr = alloc(size)
    var i = 0
    var sum = 0
    
    while (i < size) {
        store(addr + i, i)
        i = i + 1
    }
    
    i = 0
    while (i < size) {
        sum = sum + load(addr + i)
        i = i + 1
    }
    
    free(addr)
    return sum
}

fun main(): Int {
    val x = storeAndLoad(42)
    val sum = arraySum(5)
    return x + sum
} 