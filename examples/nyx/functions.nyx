fun identity(x: Int): Int {
    return x
}

fun addAndReturn(a: Int, b: Int): Int {
    val sum = a + b
    return sum
}

fun nestedCalls(x: Int): Int {
    val y = identity(x)
    val z = addAndReturn(y, 5)
    return identity(z)
}

fun chainCalls(x: Int): Int {
    return identity(addAndReturn(x, nestedCalls(x)))
}

fun main(): Int {
    val a = identity(42)
    val b = addAndReturn(a, 8)
    val c = nestedCalls(b)
    return chainCalls(c)
} 