fun add(a: Int, b: Int): Int {
    return a + b
}

fun sub(a: Int, b: Int): Int {
    return a - b
}

fun mul(a: Int, b: Int): Int {
    return a * b
}

fun div(a: Int, b: Int): Int {
    return a / b
}

fun main(): Int {
    val x = add(10, 5)
    val y = sub(x, 3)
    val z = mul(y, 2)
    return div(z, 3)
} 