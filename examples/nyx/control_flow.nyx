fun isPositive(x: Int): Int {
    return if (x > 0) {
        1
    } else {
        0
    }
}

fun factorial(n: Int): Int {
    return if (n <= 1) {
        1
    } else {
        n * factorial(n - 1)
    }
}

fun fibonacci(n: Int): Int {
    return if (n <= 1) {
        n
    } else {
        fibonacci(n - 1) + fibonacci(n - 2)
    }
}

fun main(): Int {
    val a = isPositive(42)
    val b = isPositive(-5)
    val c = factorial(5)
    val d = fibonacci(6)
    return a + b + c + d
} 